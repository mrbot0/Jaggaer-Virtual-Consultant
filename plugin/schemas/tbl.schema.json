{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tbl.schema.json",
  "title": "Tabella del data model Analytics (TBL)",
  "description": "§20.3: enumerazione del data model (subject area, colonne con chiavi e valori visti), join noti dai report, righe osservate, validazione (conteggi e campioni contro il profilo → confidenza 1.00), forma epistemica, portabilità.",
  "allOf": [
    {
      "$ref": "item.base"
    },
    {
      "$ref": "#/$defs/tbl"
    }
  ],
  "$defs": {
    "tbl": {
      "type": "object",
      "required": [
        "type",
        "table",
        "columns"
      ],
      "properties": {
        "type": {
          "const": "TBL"
        },
        "subject_area": {
          "type": "string"
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string"
              },
              "key": {
                "enum": [
                  "primary",
                  "foreign",
                  "none"
                ]
              },
              "key_ref": {
                "type": "string"
              },
              "values_seen": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "currency_col": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "joins_known": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "to",
              "on"
            ],
            "properties": {
              "to": {
                "type": "string",
                "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.TBL\\.\\d{4}(\\.v\\d+)?$"
              },
              "on": {
                "type": "string"
              },
              "from_report": {
                "type": "string"
              }
            }
          }
        },
        "row_count_observed": {
          "type": "integer",
          "minimum": 0
        },
        "validated": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "coherent_with_profile": {
              "type": "boolean"
            }
          }
        },
        "epistemic": {
          "type": "object"
        },
        "portability": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "enum": [
                "universale",
                "condizionata",
                "specifica",
                "ignota"
              ]
            },
            "condition": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
