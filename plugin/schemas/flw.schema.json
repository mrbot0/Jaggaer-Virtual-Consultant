{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flw.schema.json",
  "title": "Flow Card (FLW)",
  "description": "§27.1: precondizioni, passi codificati (vocabolario dei verbi dei piani; DELETE non esiste), postcondizioni, invarianti, compensazione close/cancel (ADR-06), evidenze. Gli attributi mancanti sono lacune epistemiche (gaps, §9), non errori: lo schema verifica la FORMA di ciò che c'è.",
  "allOf": [{ "$ref": "item.base" }, { "$ref": "#/$defs/flw" }],
  "$defs": {
    "cond": { "type": "array", "items": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "object", "minProperties": 1 }] } },
    "flw": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "FLW" },
        "actor": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "trigger": { "type": "string" },
        "document": { "type": "string" },
        "preconditions": { "$ref": "#/$defs/cond" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "defs.schema.json#/$defs/step" } },
        "postconditions": { "$ref": "#/$defs/cond" },
        "invariants": { "$ref": "#/$defs/cond" },
        "compensation": { "$ref": "defs.schema.json#/$defs/compensation" },
        "evidence": { "$ref": "defs.schema.json#/$defs/evidence" },
        "handoffs": { "type": "array", "items": { "type": "string", "pattern": "^[SC]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.HND\\.\\d{4}(\\.v\\d+)?$" } },
        "derives_from": { "type": "string", "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.FLW\\.\\d{4}(\\.v\\d+)?$" },
        "deviations": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
