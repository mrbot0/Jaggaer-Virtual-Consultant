{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fld.schema.json",
  "title": "Campo di un documento (FLD)",
  "description": "Item FLD (§19.6.2) con la carta d'identità del dato (§19.20). Estende item.base. `type` è il tipo dell'item (FLD); il tipo del campo (text · number · date · lookup · list · flag · file · table) è `field_type`. `mandatory` è una REGOLA, non un flag: il testo di obbligatorietà così com'è scritto va in `mandatory_text` finché non è parsato. Le regole di grafo che JSON Schema non esprime (kind conditional con condizione; system_of_record per i campi in un mapping INT; al più un CL-FLD e un CL-FLD-MAND) sono in scripts/kb/validate-fld.mjs.",
  "allOf": [
    {
      "$ref": "item.base"
    },
    {
      "$ref": "#/$defs/fld"
    }
  ],
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.[A-Z]{3}\\.\\d{4}(\\.v\\d+)?$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringOrList": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "block": {
      "type": [
        "object",
        "null"
      ]
    },
    "mandatory": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "always",
            "conditional",
            "never",
            "undocumented"
          ]
        },
        "in_states": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "when": {
          "$ref": "#/$defs/nullableString"
        },
        "by_role": {
          "$ref": "#/$defs/stringOrList"
        },
        "unless": {
          "$ref": "#/$defs/nullableString"
        },
        "reason": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "integration",
                "workflow",
                "legal",
                "business",
                "ui",
                "derived",
                null
              ]
            },
            "ref": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "doc": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "genre": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "confirmed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modality": {
          "type": "string",
          "description": "modalità deontica da cui la regola è stata parsata (scripts/ingest/deontic.mjs)"
        }
      }
    },
    "fld": {
      "type": "object",
      "required": [
        "type",
        "document",
        "label",
        "section",
        "field_type"
      ],
      "properties": {
        "type": {
          "const": "FLD"
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "technical_name": {
          "$ref": "#/$defs/nullableString"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "field_type": {
          "enum": [
            "text",
            "number",
            "date",
            "lookup",
            "list",
            "flag",
            "file",
            "table"
          ]
        },
        "options_source": {
          "$ref": "#/$defs/nullableString"
        },
        "key_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "mandatory": {
          "$ref": "#/$defs/mandatory"
        },
        "mandatory_text": {
          "type": "string",
          "description": "testo di obbligatorietà così com'è scritto nella fonte (verbatim)"
        },
        "editable_in_states": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "default": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "ref": {
              "$ref": "#/$defs/nullableString"
            },
            "value": {}
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "on_fail"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "on_fail": {
                "enum": [
                  "block",
                  "warn"
                ]
              },
              "message_ref": {
                "type": "string"
              }
            }
          }
        },
        "visibility": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "roles": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "when": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "lineage": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "derived_from": {
              "oneOf": [
                {
                  "$ref": "#/$defs/code"
                },
                {
                  "type": "null"
                }
              ]
            },
            "propagates_to": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field"
                ],
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "$ref": "#/$defs/code"
                  },
                  "document": {
                    "type": "string"
                  },
                  "transform": {
                    "type": "string"
                  }
                }
              }
            },
            "required_by": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "ref"
                ],
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "$ref": "#/$defs/code"
                  },
                  "mapping": {
                    "type": "string"
                  },
                  "mandatory_there": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  },
                  "one_of": {
                    "type": "object",
                    "description": "obbligatorietà uno-fra di una xs:choice (WP09b): il campo non è obbligatorio da solo (mandatory_there false), il gruppo sì se required",
                    "required": [
                      "group",
                      "required"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "group": {
                        "type": "string",
                        "minLength": 1
                      },
                      "required": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "integration_relevance": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "custom": {
          "type": "boolean"
        },
        "deviates_from": {
          "$ref": "#/$defs/code"
        },
        "cluster": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CL-[A-Z]{3}(-[A-Z]{3,5})?-\\d{3}$"
          }
        },
        "notes": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "epistemic": {
          "type": "object",
          "properties": {
            "shape": {
              "enum": [
                "consolidato",
                "libresco",
                "empirico",
                "contraddittorio",
                "ignoto"
              ]
            },
            "k_tech": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "k_use": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "k_obs": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "k_exec": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "identity": {
          "type": "object",
          "description": "Carta d'identità del dato, dodici blocchi (§19.20). Un blocco assente o null è un gap.",
          "additionalProperties": false,
          "properties": {
            "names": {
              "$ref": "#/$defs/block"
            },
            "datatype": {
              "$ref": "#/$defs/block"
            },
            "domain": {
              "$ref": "#/$defs/block"
            },
            "constraints": {
              "$ref": "#/$defs/block"
            },
            "structure": {
              "$ref": "#/$defs/block"
            },
            "relations": {
              "$ref": "#/$defs/block"
            },
            "system_of_record": {
              "$ref": "#/$defs/block"
            },
            "ownership": {
              "$ref": "#/$defs/block"
            },
            "lifecycle": {
              "$ref": "#/$defs/block"
            },
            "sensitivity": {
              "$ref": "#/$defs/block"
            },
            "errors": {
              "$ref": "#/$defs/block"
            },
            "real_data": {
              "$ref": "#/$defs/block"
            }
          }
        },
        "identity_quality": {
          "type": "object",
          "required": [
            "blocks_covered",
            "missing"
          ],
          "additionalProperties": false,
          "properties": {
            "blocks_covered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "Q": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "shape": {
              "enum": [
                "consolidato",
                "libresco",
                "empirico",
                "contraddittorio",
                "ignoto"
              ]
            }
          }
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Modulo JAGGAER di appartenenza (soluzione A): dalle briciole di pane o dal percorso di menu, es. \"Acquisti › Ordini\"."
        }
      }
    }
  }
}
