<?xml version="1.0" encoding="UTF-8"?>
<!-- esempio sintetico -->
<ReqConfig>
  <VersionDescription>Configurazione richiesta ACME</VersionDescription>
  <AllowedCartViews>Simple</AllowedCartViews>
  <InitialCartView>Simple</InitialCartView>
  <Section id="S1"><Name>General</Name><TitleAndHelp lang="00"><Title>Informazioni generali</Title><HelpText></HelpText></TitleAndHelp></Section>
  <Group id="G1"><Name>Header</Name><SectionRef id="S1"/><TitleAndHelp lang="00"><Title>Testata</Title><HelpText></HelpText></TitleAndHelp></Group>
