    <ElementValidation event="Empty"><ValidationEventHandling type="Checkout">Error</ValidationEventHandling><ValidationEventHandling type="Default">Ignore</ValidationEventHandling></ElementValidation>
    <ElementValidation event="Invalid"><ValidationEventHandling type="Checkout">Error</ValidationEventHandling></ElementValidation>
  </Element>
  <Element type="static" id="ProjectCode">
    <GroupRef id="G1"/>
    <DisplayOrder>2</DisplayOrder>
    <ElementValidation event="Empty"><ValidationEventHandling type="Default">Ignore</ValidationEventHandling></ElementValidation>
  </Element>
