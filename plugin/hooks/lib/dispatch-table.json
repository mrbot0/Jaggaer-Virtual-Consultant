{
  "note": "Tabella dei guard di PreToolUse (29/10/2026, punto 5: un solo processo per chiamata). Stessa struttura dei gruppi di hooks.json: matcher (regex ancorata sul nome dello strumento) e script dei guard. La esegue hooks/scripts/pre-dispatch.mjs in ordine, con guard-config-scope per ultimo (consuma i token delle approvazioni) e stop al primo deny.",
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-phrase.mjs\"",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-control.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Glob|Grep",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-domain-boundary.mjs\"",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-scope.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Glob|Grep|Bash|PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-customer.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Agent|Task",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-budget.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Bash|PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-budget.mjs\"",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-scope.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "mcp__.*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-environment.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "mcp__.*([Cc]hrome|[Bb]rowser|[Pp]laywright|[Pp]uppeteer|[Ss]elenium|[Dd]ev[Tt]ools).*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-production.mjs\"",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-config-scope.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-config-scope.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*([Cc]hrome|[Bb]rowser|[Pp]laywright|[Pp]uppeteer|[Ss]elenium|[Dd]ev[Tt]ools).*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-destructive.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "mcp__.*([Aa][Ll][Mm]|[Jj][Ii][Rr][Aa]|[Aa][Tt][Ll][Aa][Ss][Ss][Ii][Aa][Nn]|[Xx][Rr][Aa][Yy]).*__.*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-alm-write.mjs\"",
          "timeout": 5
        }
      ]
    }
  ]
}
