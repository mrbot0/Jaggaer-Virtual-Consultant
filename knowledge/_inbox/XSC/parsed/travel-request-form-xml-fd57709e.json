ength":null,"validations":[]},{"kind":"element","name":"10004","internal_name":"Motor Fleet Vehicle Requested?","title":"Motor Fleet Vehicle Requested?","group":"Supplier","element_type":"userdefined","field_type":"RadioButtonGroup","mandatory":"Sì","read_only":"false","max_length":null,"validations":[]}]},{"path":"campi-2","title":"Campi —","level":1,"page":null,"paragraphs":[],"tables":[{"caption":"campi","headers":["Nome tecnico","Campo","Tipo","Obbligatorio","Gruppo","Sola lettura","Lunghezza massima","Convalide","Note"],"rows":[["Instructions","","HTML","No","","false","","","UserDefinedFieldParamHTML=<!DOCTYPE html> <html lang=\"en\"> <head> <meta charset=\"utf-8\"> <meta name=\"generator\" content=\"CoffeeCup HTML Editor (www.coffeecup.com)\"> <meta name=\"created\" content=\"Wed, 22 Aug 2012 19:50:42 GMT\"> <meta name=\"description\" content=\"\"> <meta name=\"keywords\" content=\"\"> <title>Viking Shoppes Travel Form</title> <style type=\"text/css\"> <!-- body { color:#000000; background-color:#FFFFFF; } a { color:#0000FF; } a:visited { color:#800080; } a:hover { color:#008000; } a:active { color:#FF0000; } --> </style> <!--[if IE]> src=\"http://html5shim.googlecode.com/svn/trunk/html5.js\"> <![endif]--> </head> <body> This Viking Shoppes Form is used to submit the <b>WorldWide Widgets Excel Travel Form</b> for electronic approval. · id=10000 · tipo=userdefined"]]}],"figures":[],"kind":"config-export","records":[{"kind":"element","name":"10000","internal_name":"Instructions","title":"","group":"Instructions","element_type":"userdefined","field_type":"HTML","mandatory":"No","read_only":"false","max_length":null,"validations":[]}]},{"path":"campi-3","title":"Campi —","level":1,"page":null,"paragraphs":[],"tables":[{"caption":"campi","headers":["Nome tecnico","Campo","Tipo","Obbligatorio","Gruppo","Sola lettura","Lunghezza massima","Convalide","Note"],"rows":[["113","113","static","Sì","","false","","","id=113 · tipo=static"]]}],"figures":[],"kind":"config-export","records":[{"kind":"element","name":"113","internal_name":null,"title":null,"group":"Travel Form File Attachment","element_type":"static","field_type":null,"mandatory":"Sì","read_only":"false","max_length":null,"validations":[]}]},{"path":"campi-4","title":"Campi —","level":1,"page":null,"paragraphs":[],"tables":[{"caption":"campi","headers":["Nome tecnico","Campo","Tipo","Obbligatorio","Gruppo","Sola lettura","Lunghezza massima","Convalide","Note"],"rows":[["Step-by-Step Instructions","","HTML","No","","false","","","UserDefinedFieldParamHTML=<body> <p></p><b>Step 1</b> - Enter Total Amount &nbsp;&nbsp;&nbsp;<blockquote>Enter the total estimated cost of the travel in the <b>Supplier </b>section.</blockquote><p></p><b>Step 2</b> - Attach File &nbsp;&nbsp;&nbsp;<blockquote>Simply attach the completed travel form from the SQUFS website under Business and Finance Forms and Documents.</blockquote> <p></p><b>Step 3</b> - Click <b><i>Go</i></b> &nbsp;&nbsp;&nbsp;<blockquote>Click the <b>Go</b> button with the Available Action: <i>Add and go to Cart</i>. </blockquote><b>Step 4</b> - Click <b><i>Proceed to Checkout</i></b> &nbsp;&nbsp;&nbsp;<blockquote>This will create a draft requisition for your travel authorization request. </blockquote><b>Step 5</b> - Enter the accounting codes &nbsp;&nbsp;&nbsp;<blockquote>Enter the fund code and the word <i>Travel</i> for the account code. </blockquote> </body><b>Step 6</b> - Assign - Click <b>Place Order</b><blockquote>If you are not the traveler, assign the cart to the traveler. The traveler will need to place the order which will complete your request for travel authorization.</blockquote> You will receive an email from the Travel Office letting you know if the travel is authorized, rejected or if you need to make changes to the travel form and resubmit. </html> · id=10001 · tipo=userdefined"]]}],"figures":[],"kind":"config-export","records":[{"kind":"element","name":"10001","internal_name":"Step-by-Step Instructions","title":