{
  "mcpServers": {
    "alm": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/alm-server/server.mjs"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.9.0"],
      "env": { "JVC_MCP_OPTIONAL": "1" }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.41"],
      "env": { "JVC_MCP_OPTIONAL": "1" }
    }
  }
}
