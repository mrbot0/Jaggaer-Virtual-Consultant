<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:acme:demo:order" xmlns:tns="urn:acme:demo:order">
  <xs:element name="OrderMessage" type="tns:OrderType"/>
  <xs:complexType name="OrderType">
    <xs:sequence>
      <xs:element name="OrderNumber">
        <xs:annotation><xs:documentation>Numero ordine assegnato dal sistema</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="20"/><xs:pattern value="PO-[0-9]+"/></xs:restriction></xs:simpleType>
      </xs:element>
      <xs:element name="CostCenter" type="xs:string" minOccurs="1"/>
      <xs:element name="Currency" minOccurs="0">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="EUR"/><xs:enumeration value="USD"/></xs:restriction></xs:simpleType>
      </xs:element>
      <xs:element name="Line" type="tns:LineType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="LineType">
    <xs:sequence>
      <xs:element name="Quantity" type="xs:decimal"/>
      <xs:element name="Note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
