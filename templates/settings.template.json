{
  "enabledPlugins": {
    "jaggaer-virtual-consultant@jaggaer-vc": true
  },
  "permissions": {
    "allow": [
      "Bash(node *jaggaer-virtual-consultant*/scripts/*)",
      "Read(product/**)",
      "Read(customers/**)",
      "Edit(customers/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env*)",
      "Read(.auth/**)",
      "Read(**/.auth/**)",
      "Bash(rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(rm:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(del:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "WebFetch"
    ]
  }
}
