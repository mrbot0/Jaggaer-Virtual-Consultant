{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.base",
  "type": "object",
  "required": ["id","type","title","summary","facets","sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.[A-Z]{3}\\.\\d{4}(\\.v\\d+)?$" },
    "type": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 140 },
    "summary": { "type": "string" },
    "facets": { "$ref": "facets.schema.json" },
    "sources": { "type": "array", "minItems": 1 }
  }
}
