{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-plan.schema.json",
  "title": "Piano di esecuzione come traccia attesa (§46.3, §10.5)",
  "description": "Eseguito dall'agente sugli strumenti MCP del browser, un passo alla volta; dopo ogni passo step-check confronta lo snapshot con `expect`. Ogni passo dichiara ciò che si aspetta di osservare (controllo 4 esteso del self-check). Vocabolario dei verbi: §5.5 (NAVIGATE · CLICK · FILL · CHOOSE · TOGGLE · UPLOAD · SAVE · SUBMIT · WAIT · VERIFY · READ · CAPTURE · ASK) più SELECT, che §5.5 usa negli esempi (S.STD.ADM.CFP.0014 passo 2) e §10.5 nel piano: incluso qui citando entrambe le sezioni. DELETE non esiste (ADR-06: compensazioni close/cancel); un verbo fuori vocabolario fa fallire la validazione e non arriva mai all'esecuzione.",
  "type": "object",
  "required": ["plan_id", "customer", "env", "goal", "steps", "repair_policy"],
  "additionalProperties": false,
  "properties": {
    "plan_id": { "type": "string", "pattern": "^PLAN\\.[A-Za-z0-9._-]+$" },
    "customer": { "type": "string", "pattern": "^[A-Z0-9]{4}$" },
    "env": { "type": "string", "minLength": 1 },
    "persona": { "type": "string", "minLength": 1 },
    "storage_state": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "strategy": {
      "description": "Strategia (o catena, es. \"STR-DRY-RUN → STR-VERIFY-FIRST\") scelta da strategy-select.",
      "oneOf": [
        { "type": "string", "pattern": "^STR-[A-Z-]+( → STR-[A-Z-]+)*$" },
        { "type": "array", "items": { "type": "string", "pattern": "^STR-[A-Z-]+$" }, "minItems": 1 }
      ]
    },
    "subject": { "type": "string", "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.[A-Z]{3}\\.\\d{4}(\\.v\\d+)?$" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "kind"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["assertion", "failure", "context", "before", "after"] },
          "capture": { "enum": ["page", "region", "element"] },
          "region": { "$ref": "#/$defs/sel" },
          "caption": { "type": "string" },
          "redact": { "enum": ["strict", "standard", "none"] }
        }
      }
    },
    "repair_policy": {
      "type": "object",
      "required": ["skip_allowed", "substitute_allowed", "abort_on"],
      "additionalProperties": false,
      "properties": {
        "skip_allowed": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "substitute_allowed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "with"],
            "additionalProperties": false,
            "properties": { "step": { "type": "integer", "minimum": 1 }, "with": { "type": "string", "minLength": 1 } }
          }
        },
        "abort_on": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "compensations": {
      "type": "array",
      "description": "Registrate PRIMA del passo che crea o modifica (§29.6). Mai delete: close · cancel · deactivate · restore (ADR-06).",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "entity": { "type": "string" },
          "kind": { "enum": ["close", "cancel", "deactivate", "restore"] },
          "ref": { "type": "string" },
          "action": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "checkpoint_dir": { "type": "string", "minLength": 1 },
    "approvals": { "const": "3A", "description": "Protocollo di tripla approvazione (§52.2): obbligatorio per un piano con ACT-CFG-CHANGE in produzione (validate-plan)." }
  },
  "$defs": {
    "verb": { "enum": ["NAVIGATE", "CLICK", "FILL", "CHOOSE", "SELECT", "TOGGLE", "UPLOAD", "SAVE", "SUBMIT", "WAIT", "VERIFY", "READ", "CAPTURE", "ASK"] },
    "sel": { "type": "string", "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.SEL\\.\\d{4}(\\.v\\d+)?$" },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/sel" },
        { "type": "object", "required": ["url_pattern"], "additionalProperties": false, "properties": { "url_pattern": { "type": "string", "minLength": 1 } } }
      ]
    },
    "step": {
      "type": "object",
      "required": ["n", "verb", "expect"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "verb": { "$ref": "#/$defs/verb" },
        "target": { "$ref": "#/$defs/target" },
        "check": { "type": "string", "pattern": "^(NRT\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.[A-Z]{3}\\.\\d{4}|[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.CHK\\.\\d{4}(\\.v\\d+)?)$" },
        "data": {},
        "risk": { "enum": ["R0", "R1", "R2", "R3"] },
        "approval": { "enum": ["required", "none"] },
        "action_class": { "type": "string", "pattern": "^ACT-[A-Z0-9-]+$" },
        "config": {
          "type": "object",
          "description": "Perimetro di un passo di configurazione (ACT-CFG-CHANGE): oggetto governato, area CL-CFG e livello DT-007 (verde/giallo/rosso). guard-config-scope lo confronta con config_levels dell'ambiente e con remediation-scope.yaml.",
          "additionalProperties": false,
          "properties": {
            "object": { "type": "string", "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.CFG\\.\\d{4}(\\.v\\d+)?$" },
            "area": { "type": "string", "pattern": "^CL-CFG-\\d{3}$" },
            "level": { "enum": ["verde", "giallo", "rosso"] },
            "dec": { "type": "string" }
          },
          "anyOf": [{ "required": ["object"] }, { "required": ["area"] }]
        },
        "expect": { "type": "object", "minProperties": 1, "description": "Cosa si osserva dopo il passo: page_sig, elements, value, toast, messages, result…" },
        "on_divergence": { "type": "object" },
        "wait_for": { "$ref": "#/$defs/sel" },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "verb": { "enum": ["NAVIGATE", "CLICK", "FILL", "CHOOSE", "SELECT", "TOGGLE", "UPLOAD", "SAVE", "SUBMIT", "READ"] } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "verb": { "const": "VERIFY" } } },
          "then": { "anyOf": [{ "required": ["check"] }, { "required": ["target"] }] }
        }
      ]
    }
  }
}
