{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pmp.schema.json",
  "title": "Mappa di processo (PMP, §19.3)",
  "description": "C.<CUST>.XSC.PMP.00nn (variante di S.STD.XSC.PMP.nnnn): fasi con scope e flussi, varianti con condizioni e quote, handoff, integrazioni, proprietario e epistemic_by_stage — la mappa del processo con la mappa di ciò che sappiamo sovrapposta. Attributi attesi e critici in schemas/expected-attributes.yaml (PMP).",
  "type": "object",
  "required": ["id", "title", "stages", "handoffs", "epistemic_by_stage"],
  "properties": {
    "id": { "type": "string", "pattern": "^[SC]\\.[A-Z0-9]{3,4}\\.XSC\\.PMP\\.\\d{4}(\\.v\\d+)?$" },
    "title": { "type": "string", "minLength": 3 },
    "variant_of": { "type": "string", "pattern": "^S\\.STD\\.XSC\\.PMP\\.\\d{4}$" },
    "applies_when": { "type": "object" },
    "owner": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "scope", "name"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "scope": { "enum": ["CAT", "SRC", "VEN", "CON", "P2P", "INV", "QLT", "ANL", "ADM", "XSC"] },
          "name": { "type": "string", "minLength": 1 },
          "flows": { "type": "array", "items": { "$ref": "#/$defs/code" } },
          "integration": { "$ref": "#/$defs/code" },
          "async": { "type": "boolean" },
          "deviates": { "type": "string" },
          "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } }
        },
        "anyOf": [ { "required": ["flows"] }, { "required": ["integration"] } ]
      }
    },
    "variants": { "type": "array", "description": "varianti del processo intero con quote (§20.5: percorsi con frequenza)", "items": { "$ref": "#/$defs/variant" } },
    "handoffs": { "type": "array", "items": { "type": "string", "pattern": "^[SC]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.HND\\.\\d{4}$" } },
    "integrations": { "type": "array", "items": { "$ref": "#/$defs/code" } },
    "epistemic_by_stage": {
      "type": "object",
      "propertyNames": { "pattern": "^\\d+$" },
      "additionalProperties": { "enum": ["consolidato", "libresco", "empirico", "ignoto", "contraddittorio"] }
    },
    "confirmed_by": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[SCL]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.[A-Z]{3}\\.\\d{4}(\\.v\\d+)?$" },
    "variant": {
      "type": "object",
      "required": ["when"],
      "properties": { "when": { "type": "string", "minLength": 1 }, "levels": { "type": "integer", "minimum": 1 }, "share": { "type": "number", "minimum": 0, "maximum": 1 }, "name": { "type": "string" } }
    }
  }
}
