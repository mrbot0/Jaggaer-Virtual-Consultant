{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pbk.schema.json",
  "title": "Playbook di risoluzione (PBK)",
  "description": "§1.1, F8: i passi per riconoscere e risolvere un pattern (dalla catena causale): verifica del sintomo, controllo della causa, risoluzione, prevenzione. Dominio analitico (§1.1): vive in analysis/, non cita mai un test (NRT.*) e kb/ non lo cita.",
  "allOf": [
    {
      "$ref": "item.base"
    },
    {
      "$ref": "#/$defs/pbk"
    }
  ],
  "$defs": {
    "pbk": {
      "type": "object",
      "required": [
        "type",
        "pattern",
        "steps"
      ],
      "properties": {
        "type": {
          "const": "PBK"
        },
        "pattern": {
          "type": "string",
          "pattern": "^[SC]\\.[A-Z0-9]{3,4}\\.[A-Z0-9]{3}\\.PAT\\.\\d{4}(\\.v\\d+)?$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "n",
              "action"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string",
                "minLength": 3
              },
              "check": {
                "type": "string"
              }
            }
          }
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prevention": {
          "type": "string"
        }
      }
    }
  }
}
